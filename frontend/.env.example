# ──────────────────────────────────────────────────────────────────────────────
# Dayflow Frontend — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (Frontend — anon key only, safe to expose in browser) ────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── n8n Webhook (optional — for local testing only) ──────────────────────────
# If you are manually triggering the n8n webhook from the frontend for testing:
# VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/evaluate-request
